#!/bin/sh
# pre-commit hook: auto-update TOC in PLAN_DEV.md or Notes.md when staged

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

for file in "docs/plans/PLAN_DEV.md" "docs/notes/Notes.md"; do
  if git diff --cached --name-only | grep -q "^$file$"; then
    python .githooks/update_toc.py "$file"
    if [ $? -eq 0 ]; then
      git add "$file"
      echo "pre-commit: TOC auto-generated in $file"
    fi
  fi
done
