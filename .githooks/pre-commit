#!/bin/sh
# pre-commit hook: auto-update TOC in PLAN_DEV.md when it is staged

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  exit 0
fi

if git diff --cached --name-only | grep -q "^docs/plans/PLAN_DEV.md$"; then
  git show :docs/plans/PLAN_DEV.md > /tmp/plan_dev_staged.md
  
  cd "$(git rev-parse --show-toplevel)" || exit 1
  
  python .githooks/update_toc.py
  
  if [ $? -eq 0 ]; then
    git add docs/plans/PLAN_DEV.md
    echo "pre-commit: TOC auto-generated in PLAN_DEV.md"
  fi
fi
