# Template de l'environnement de PRODUCTION (PostgreSQL).
# Copier vers `.env.production` (sur le serveur) et renseigner les valeurs. NE PAS committer de secrets.

# --- SendGrid (emails) ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=no-reply@example.com
FROM_NAME=APP_SDGPS

# --- Environnement ---
# production → PostgreSQL. Sélecteur lu depuis l'OS (docker-compose/Railway pose ENVIRONMENT).
ENVIRONMENT=production
SHOW_TEST_DATA=false

# --- Django (sécurité) ---
# OBLIGATOIRE en prod : clé secrète forte et unique (ex. `python -c "import secrets;print(secrets.token_urlsafe(50))"`).
SECRET_KEY=change-me-with-a-strong-random-key
DEBUG=false
# Hôtes autorisés (séparés par des virgules). Sur Railway : le sous-domaine généré.
ALLOWED_HOSTS=votre-app.up.railway.app
# Origines de confiance pour le login admin en HTTPS (schéma inclus).
CSRF_TRUSTED_ORIGINS=https://votre-app.up.railway.app
# Si le frontend est hébergé sur une AUTRE origine (sinon laisser vide — SPA servi par Django) :
# CORS_ALLOWED_ORIGINS=https://front.example.com

# --- Base de données ---
# Option A (recommandée sur Railway) : une seule URL, prioritaire si définie.
#   DATABASE_URL=${{Postgres.DATABASE_URL}}   (référence de variable Railway)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Option B (docker-compose) : paramètres séparés. En compose, l'hôte est le service `db`.
POSTGRES_DB=sdgps
POSTGRES_USER=sdgps
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Super Admin (seedé automatiquement) ---
SUPER_ADMIN_EMAIL=admin@example.com
# Laisser vide pour un mot de passe aléatoire (affiché dans les logs de migrate).
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_ORG_NAME=SDGPS Administration
# SUPER_ADMIN_ORG_CODE=SDGPS-ADMIN-1234

# --- Admins d'application (ROLE_ADMIN_SYSTEME, seedés automatiquement) ---
APP_ADMIN1_EMAIL=appadmin1@example.com
APP_ADMIN1_PASSWORD=change-me
APP_ADMIN2_EMAIL=appadmin2@example.com
APP_ADMIN2_PASSWORD=change-me

# --- Admins d'organisation seedés (orgadmin1/2/3 de initial_data.json, mot de passe commun) ---
ORGADMIN_PASSWORD=change-me

# --- Amorçage ---
# Production = données d'initialisation UNIQUEMENT (les données de démo sont interdites).
SEED_INITIAL_DATA=1
# Mot de passe des utilisateurs seedés non super-admin. Vide → généré aléatoirement (recommandé
# en prod : réinitialiser ensuite via l'admin).
SEED_DEFAULT_PASSWORD=
# Fichier JSON externe des données d'initialisation (organisations, organismes, identités
# admins). Par défaut : accounts/seed_data/initial_data.json (embarqué). En production, monter
# un fichier via un volume Docker et pointer dessus pour modifier la liste sans reconstruire.
# SEED_DATA_FILE=/app/config/initial_data.json

# --- Stockage des fichiers (uploads) ---
# Sur Railway (service unique), monter un VOLUME persistant sur /app/media : le disque du
# conteneur est éphémère, les uploads seraient sinon perdus à chaque redéploiement.
# Alternative durable/scalable : bucket S3-compatible (Cloudflare R2, S3…) via ces variables
# (django-storages déjà installé). Renseigner AWS_STORAGE_BUCKET_NAME active le mode S3.
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=      # requis pour R2/MinIO/OVH (non-AWS)
# AWS_S3_CUSTOM_DOMAIN=     # domaine public/CDN optionnel
