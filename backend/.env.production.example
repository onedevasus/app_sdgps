# Template de l'environnement de PRODUCTION (PostgreSQL).
# Copier vers `.env.production` (sur le serveur) et renseigner les valeurs. NE PAS committer de secrets.

# --- SendGrid (emails) ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=no-reply@example.com
FROM_NAME=APP_SDGPS

# --- Environnement ---
# production → PostgreSQL. Sélecteur lu depuis l'OS (docker-compose pose ENVIRONMENT=production).
ENVIRONMENT=production
SHOW_TEST_DATA=false

# --- Base de données PostgreSQL ---
POSTGRES_DB=sdgps
POSTGRES_USER=sdgps
POSTGRES_PASSWORD=change-me
# En docker-compose, l'hôte est le service `db` (surchargé par compose).
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Super Admin (seedé automatiquement) ---
SUPER_ADMIN_EMAIL=admin@example.com
# Laisser vide pour un mot de passe aléatoire (affiché dans les logs de migrate).
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_ORG_NAME=SDGPS Administration
# SUPER_ADMIN_ORG_CODE=SDGPS-ADMIN-1234

# --- Admins d'application (ROLE_ADMIN_SYSTEME, seedés automatiquement) ---
APP_ADMIN1_EMAIL=appadmin1@example.com
APP_ADMIN1_PASSWORD=change-me
APP_ADMIN2_EMAIL=appadmin2@example.com
APP_ADMIN2_PASSWORD=change-me

# --- Amorçage ---
# Production = données d'initialisation UNIQUEMENT (les données de démo sont interdites).
SEED_INITIAL_DATA=1
