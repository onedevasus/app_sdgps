# Template de l'environnement de PREPROD (validation client, PostgreSQL dédié).
# Copier vers `.env.preprod` et renseigner les valeurs. NE PAS committer de secrets.
# Preprod = base PostgreSQL PROPRE à cet environnement (jamais partagée). Environnement
# « type production » : données de démo/test INTERDITES et MASQUÉES (le client ne voit que
# des données réelles), comme en production.

# --- Environnement ---
ENVIRONMENT=preprod
SHOW_TEST_DATA=false

# --- SendGrid (emails) ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=no-reply@preprod.example.com
FROM_NAME=APP_SDGPS (preprod)

# --- Django (sécurité) ---
SECRET_KEY=change-me-with-a-strong-random-key
DEBUG=false
ALLOWED_HOSTS=votre-app-preprod.up.railway.app
CSRF_TRUSTED_ORIGINS=https://votre-app-preprod.up.railway.app

# --- Base de données (dédiée à preprod) ---
#   DATABASE_URL=${{Postgres.DATABASE_URL}}   (référence de variable Railway)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
POSTGRES_DB=sdgps
POSTGRES_USER=sdgps
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Comptes seedés (mêmes données d'initialisation que les autres environnements) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_ORG_NAME=SDGPS Administration
APP_ADMIN1_EMAIL=appadmin1@example.com
APP_ADMIN1_PASSWORD=change-me
APP_ADMIN2_EMAIL=appadmin2@example.com
APP_ADMIN2_PASSWORD=change-me
ORGADMIN_PASSWORD=change-me
SEED_DEFAULT_PASSWORD=

# --- Amorçage ---
# Preprod = données d'initialisation UNIQUEMENT (données de démo interdites, comme en prod).
SEED_INITIAL_DATA=1

# --- Stockage (volume Railway /app/media, ou S3/R2 — cf. .env.production.example) ---
# AWS_STORAGE_BUCKET_NAME=
