# Template de l'environnement de STAGING (tests équipe, PostgreSQL dédié).
# Copier vers `.env.staging` et renseigner les valeurs. NE PAS committer de secrets.
# Staging = base PostgreSQL PROPRE à cet environnement (jamais partagée avec dev/preprod/prod).
# Les données de démo/test y sont AUTORISÉES et VISIBLES (contrairement à preprod/production).

# --- Environnement ---
ENVIRONMENT=staging
SHOW_TEST_DATA=true

# --- SendGrid (emails) ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=no-reply@staging.example.com
FROM_NAME=APP_SDGPS (staging)

# --- Django (sécurité) ---
SECRET_KEY=change-me-with-a-strong-random-key
DEBUG=false
ALLOWED_HOSTS=votre-app-staging.up.railway.app
CSRF_TRUSTED_ORIGINS=https://votre-app-staging.up.railway.app

# --- Base de données (dédiée à staging) ---
#   DATABASE_URL=${{Postgres.DATABASE_URL}}   (référence de variable Railway)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
POSTGRES_DB=sdgps
POSTGRES_USER=sdgps
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Comptes seedés (mêmes données d'initialisation que les autres environnements) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_ORG_NAME=SDGPS Administration
APP_ADMIN1_EMAIL=appadmin1@example.com
APP_ADMIN1_PASSWORD=change-me
APP_ADMIN2_EMAIL=appadmin2@example.com
APP_ADMIN2_PASSWORD=change-me
ORGADMIN_PASSWORD=change-me
SEED_DEFAULT_PASSWORD=

# --- Amorçage ---
SEED_INITIAL_DATA=1

# --- Stockage (volume Railway /app/media, ou S3/R2 — cf. .env.production.example) ---
# AWS_STORAGE_BUCKET_NAME=
