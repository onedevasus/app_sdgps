# ============================================
# Fichier de configuration pour PRODUCTION
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================

# Configuration SendGrid pour l'envoi d'emails
SENDGRID_API_KEY=VOTRE_CLE_SENDGRID_ICI
FROM_EMAIL=votre-email@domaine.com
FROM_NAME=APP_SDGPS

# ============================================
# Configuration Super Admin (RBAC)
# ============================================
SUPER_ADMIN_EMAIL=admin@domaine.com
# IMPORTANT: Changez ce mot de passe après première connexion !
SUPER_ADMIN_PASSWORD=ChangezCeMotDePasse123!

SUPER_ADMIN_ORG_NAME=SDGPS Administration
SUPER_ADMIN_ORG_CODE=SDGPS-ADMIN-PROD

# ============================================
# Configuration Environnement & Données de Test
# ============================================
# MODE PRODUCTION - Ne pas modifier !
ENVIRONMENT=production
SHOW_TEST_DATA=false
