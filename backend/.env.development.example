# Template de l'environnement de DÉVELOPPEMENT (SQLite).
# Copier vers `.env.development` et renseigner les valeurs. NE PAS committer de secrets réels.

# --- SendGrid (emails) ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=dev@example.com
FROM_NAME=APP_SDGPS

# --- Environnement ---
# development → SQLite (base locale db.sqlite3). Sélecteur lu depuis l'OS/shell.
ENVIRONMENT=development
SHOW_TEST_DATA=true

# --- Base de données ---
# Dérivée de ENVIRONMENT. Décommenter pour forcer un moteur.
# DB_ENGINE=sqlite
# SQLITE_PATH=

# --- Super Admin (seedé automatiquement) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_ORG_NAME=SDGPS Administration
# SUPER_ADMIN_ORG_CODE=SDGPS-ADMIN-1234

# --- Admins d'application (ROLE_ADMIN_SYSTEME, seedés automatiquement) ---
APP_ADMIN1_EMAIL=appadmin1@example.com
APP_ADMIN1_PASSWORD=change-me
APP_ADMIN2_EMAIL=appadmin2@example.com
APP_ADMIN2_PASSWORD=change-me

# --- Amorçage ---
SEED_INITIAL_DATA=1
# Mot de passe des utilisateurs seedés non super-admin (agents…). Vide → généré aléatoirement.
SEED_DEFAULT_PASSWORD=change-me
# Fichier JSON externe des données d'initialisation (défaut : accounts/seed_data/initial_data.json).
# SEED_DATA_FILE=/chemin/vers/initial_data.json
# Migration ponctuelle des données legacy (import uniquement) :
# SQLITE_LEGACY_PATH=/chemin/vers/db.sqlite3
