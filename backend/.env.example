# Exemple de configuration backend SDGPS — copier vers `.env` et renseigner les valeurs.
# NE PAS committer de secrets réels : ce fichier ne contient que des placeholders.

# ============================================
# SendGrid (emails)
# ============================================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=no-reply@example.com
FROM_NAME=APP_SDGPS

# ============================================
# Base de données
# ============================================
# Le moteur est dérivé de ENVIRONMENT (voir plus bas) : SQLite en 'development',
# PostgreSQL en 'production'. Décommenter DB_ENGINE pour forcer explicitement le moteur.
# DB_ENGINE=postgresql
POSTGRES_DB=sdgps
POSTGRES_USER=sdgps
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# Super Admin (seedé automatiquement à chaque migrate)
# ============================================
SUPER_ADMIN_EMAIL=admin@example.com
# Laisser vide pour générer un mot de passe aléatoire (affiché dans les logs de migrate).
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_ORG_NAME=SDGPS Administration
# SUPER_ADMIN_ORG_CODE=SDGPS-ADMIN-1234

# ============================================
# Admins d'application (ROLE_ADMIN_SYSTEME) — seedés automatiquement
# ============================================
APP_ADMIN1_EMAIL=appadmin1@example.com
APP_ADMIN1_PASSWORD=change-me
APP_ADMIN2_EMAIL=appadmin2@example.com
APP_ADMIN2_PASSWORD=change-me

# ============================================
# Environnement & seed
# ============================================
# 'development' → SQLite (base locale) ; 'production' → PostgreSQL.
ENVIRONMENT=development
SHOW_TEST_DATA=true
# Mettre à 0 pour désactiver l'auto-seed (ex. import ponctuel des données legacy).
SEED_INITIAL_DATA=1
# Chemin de l'ancienne base SQLite (activé uniquement pendant la migration des données).
# SQLITE_LEGACY_PATH=/chemin/vers/db.sqlite3
